{
  "name": "@wmaurer/effect-ai-amazon-bedrock",
  "version": "0.4.1",
  "type": "module",
  "license": "MIT",
  "author": "Wayne Maurer",
  "description": "An Amazon Bedrock provider for Effect AI, built on the Converse and ConverseStream APIs",
  "homepage": "https://github.com/wmaurer/effect-ai-amazon-bedrock/tree/main/packages/amazon-bedrock#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/wmaurer/effect-ai-amazon-bedrock.git",
    "directory": "packages/amazon-bedrock"
  },
  "bugs": {
    "url": "https://github.com/wmaurer/effect-ai-amazon-bedrock/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "ai",
    "llm",
    "aws",
    "amazon-bedrock",
    "bedrock"
  ],
  "keywords": [
    "typescript",
    "effect",
    "ai",
    "llm",
    "aws",
    "amazon-bedrock",
    "bedrock"
  ],
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./index": null,
      "./*/index": null
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json",
    "prepublishOnly": "node -e \"for (const path of ['dist', 'tsconfig.tsbuildinfo']) fs.rmSync(path, { recursive: true, force: true })\" && pnpm build"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "effect": "4.0.5"
  },
  "peerDependencies": {
    "effect": "^4.0.5"
  }
}
