{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "check": "tsc -b tsconfig.json",
    "lint": "oxlint -f unix && dprint check",
    "lint-fix": "oxlint --fix && dprint fmt",
    "test": "vitest",
    "test:live": "EFFECT_INTEGRATION_TESTS=1 vitest run --no-file-parallelism test/live",
    "deps:fetch": "node scripts/repos.js deps fetch",
    "deps:check": "node scripts/repos.js deps check",
    "refs:fetch": "node scripts/repos.js refs fetch"
  },
  "devDependencies": {
    "@babel/cli": "8.0.6",
    "@babel/core": "8.0.7",
    "@effect/oxc": "workspace:^",
    "@effect/tsgo": "0.53.4",
    "@effect/vitest": "4.0.6",
    "@types/node": "^26.6.5",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "dprint": "0.63.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
